# Copied to .env by `make up` on first run. Everything is local; no API keys needed.

# --- Models (pulled into Ollama by `make up`) --------------------------------
# smart: profile/fact extraction · fast: cheap tasks · embed: 768-dim embeddings
MODEL_SMART=qwen2.5:7b
MODEL_FAST=qwen2.5:3b
MODEL_EMBED=nomic-embed-text

# Which gateway alias each pipeline step uses (smart | fast)
MODEL_PROFILE=smart
MODEL_FACTS=smart

# --- Ollama -------------------------------------------------------------------
# auto: native Ollama on macOS (Metal GPU), a container on Linux.
# Force with: native | container
OLLAMA_MODE=auto

# --- Host ports ---------------------------------------------------------------
CORE_PORT=8080
LITELLM_PORT=4000
PHOENIX_PORT=6006
POSTGRES_PORT=5433
S3_UI_PORT=8888

# --- Local credentials (dev only) ---------------------------------------------
POSTGRES_PASSWORD=jobmatcher
S3_ACCESS_KEY=jobmatcher
S3_SECRET_KEY=jobmatcher-secret
LITELLM_MASTER_KEY=sk-jobmatcher-local

# --- Pipeline -----------------------------------------------------------------
PIPELINE_WORKERS=1
MAX_UPLOAD_MB=10
